# =========================================================================
# 1. DEPENDENCIES & PACKAGES (Never push these, they make your repo massive)
# =========================================================================
node_modules/
**/node_modules/
jspm_packages/
typings/

# =========================================================================
# 2. SECURITY & ENVIRONMENT VARIABLES (CRITICAL: Never leak your API/DB keys)
# =========================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
config.js
config/local.js

# =========================================================================
# 3. PRODUCTION BUILDS & OUTPUTS (Generated automatically on deployment)
# =========================================================================
# Frontend build folders (React / Vite / Create React App)
dist/
build/
**/dist/
**/build/
out/
.next/

# =========================================================================
# 4. LOGS, CACHES, AND DIAGNOSTICS
# =========================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
.cache/

# =========================================================================
# 5. IDE, EDITORS, AND SYSTEM FILES (Specific to your personal computer)
# =========================================================================
# IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Operating Systems
.DS_Store
Thumbs.db
