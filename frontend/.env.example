# Local development API URL.
VITE_API_BASE_URL=http://localhost:5000/api

# On Vercel production, set VITE_API_BASE_URL=/api. The Vercel rewrite then
# proxies requests to the Render backend so secure session cookies are first-party.
# Never expose backend secrets as VITE_ variables.
VITE_RAZORPAY_KEY=
