# Required for the backend to start and authenticate users.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/645-run-club
JWT_SECRET=replace-with-a-long-random-secret

# Add your deployed frontend origin here; local Vite origins are allowed by default.
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0

# Optional chatbot configuration. The chatbot needs a Gemini API key to answer messages.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHAT_MAX_MESSAGE_LENGTH=1000
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000

# Optional email configuration. Resend takes priority over Brevo, then Gmail SMTP.
# For Resend or Brevo, use a verified sender address and the provider's API key.
EMAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=

# Gmail SMTP fallback: use a Gmail address and an app password, not your account password.
EMAIL_USER=
EMAIL_PASS=
