PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/645-run-club
JWT_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_ORIGIN=https://your-run-club-site.example
TRUST_PROXY_HOPS=0
CHAT_MAX_MESSAGE_LENGTH=1000
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000

# Email: an HTTP API is used when a key is set, otherwise Gmail SMTP.
# Hosts such as Render's free tier block outbound SMTP (ports 25/465/587),
# so set RESEND_API_KEY or BREVO_API_KEY in production.
EMAIL_FROM=your-verified-sender@example.com
RESEND_API_KEY=
BREVO_API_KEY=

# Gmail SMTP fallback (works locally).
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password
